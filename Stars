@router.message(BuyStates.entering_custom_amount)
async def process_custom_amount(message: Message, state: FSMContext):
    if not message.text.isdigit() or not (50 <= int(message.text) <= 11363):
        await message.answer("⚠️ Введите число от 50 до 11363:")
        return
    amount = int(message.text)
    price = round(amount * RATE, 2)
    await state.update_data(amount=amount, price=price)
    await state.set_state(BuyStates.entering_recipient)
    text = f"🎉 Вы выбрали: {amount} ⭐ — {price}₽\n\nОтправьте @username получателя (от 5 до 32 символов) или нажмите «Купить себе»:"
