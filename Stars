@router.message(Command("confirm"))
async def cmd_confirm(message: Message):
    if message.from_user.id != ADMIN_ID:
        return
    args = message.text.split()
    if len(args) < 2:
        await message.answer("Использование: /confirm <ID заказа>")
        return
    found = next((o for oid, o in data["orders"].items() if oid.startswith(args[1])), None)
    if not found:
        await message.answer("Заказ не найден.")
        return
    found["status"] = "оплачено"
 
    if found.get("type") == "premium":
        save_data(data)
        await bot.send_message(
            int(found["user_id"]),
            f"✅ Заказ №{found['id'][:8]} подтверждён! 💎 Premium ({found['label']}) скоро будет активирован.",
        )
    else:
        buyer_id = int(found["user_id"])
        buyer = get_user(data, buyer_id)
        buyer["total_bought"] += found["amount"]
        save_data(data)
        await bot.send_message(
            buyer_id,
            f"✅ Заказ №{found['id'][:8]} подтверждён! ⭐ {found['amount']} отправлено.",
        )
 
    await message.answer(f"Заказ {args[1]} подтверждён.")
 
@router.message(Command("confirm_withdraw"))
async def cmd_confirm_withdraw(message: Message):
    if message.from_user.id != ADMIN_ID:
        return
    args = message.text.split()
    if len(args) < 2:
        await message.answer("Использование: /confirm_withdraw <ID вывода>")
        return
    withdrawals = data.get("withdrawals", {})
    found = next((w for wid, w in withdrawals.items() if wid.startswith(args[1])), None)
    if not found:
        await message.answer("Заявка на вывод не найдена.")
        return
    user = get_user(data, found["user_id"])
    user["referral_withdrawn"] += found["amount"]
    found["status"] = "выплачено"
    save_data(data)
    await bot.send_message(int(found["user_id"]), f"✅ Ваш вывод №{found['id'][:8]} на {found['amount']:.2f} звёзд выполнен.")
    await message.answer(f"Вывод {args[1]} подтверждён.")
 
