@router.message(WithdrawStates.entering_requisites)
async def process_withdraw(message: Message, state: FSMContext):
    user = get_user(data, message.from_user.id)
    current_balance = user["referral_earned"] - user["referral_withdrawn"]
    if current_balance < MIN_WITHDRAW:
        await message.answer(f"❌ Недостаточно звёзд для вывода. Ваш баланс: {current_balance:.2f} ⭐")
        await state.clear()
        return
 
    withdraw_id = str(uuid.uuid4())
    data["withdrawals"][withdraw_id] = {
        "id": withdraw_id,
        "user_id": str(message.from_user.id),
        "username": message.from_user.username or "",
        "amount": current_balance,
        "requisites": message.text,
        "status": "ожидает выплаты",
        "created_at": datetime.now().isoformat(),
    }
    save_data(data)
 
    await bot.send_message(
        ADMIN_ID,
        f"💸 Запрос на вывод №{withdraw_id[:8]}\n"
        f"От: @{message.from_user.username or message.from_user.id}\n"
