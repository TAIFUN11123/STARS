# -------------------- ХЕЛПЕРЫ ДЛЯ ОТПРАВКИ С КАРТИНКОЙ --------------------
 
def _has_banner() -> bool:
    return os.path.exists(BANNER_PATH)
 
async def send_screen(message: Message, text: str, reply_markup=None):
    if _has_banner():
        photo = FSInputFile(BANNER_PATH)
        await message.answer_photo(photo=photo, caption=text, reply_markup=reply_markup)
    else:
        await message.answer(text, reply_markup=reply_markup)
 
async def edit_screen(callback: CallbackQuery, text: str, reply_markup=None):
    if _has_banner() and callback.message.photo:
        media = InputMediaPhoto(media=FSInputFile(BANNER_PATH), caption=text)
        await callback.message.edit_media(media=media, reply_markup=reply_markup)
    elif _has_banner():
        await callback.message.delete()
        photo = FSInputFile(BANNER_PATH)
        await callback.message.answer_photo(photo=photo, caption=text, reply_markup=reply_markup)
    else:
        await callback.message.edit_text(text, reply_markup=reply_markup)
 
