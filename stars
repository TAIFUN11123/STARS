@router.message(Command("wallet"))
async def cmd_wallet_check(message: Message):
    if not is_admin(message.from_user.id):
        return
    if not FRAGMENT_ENABLED:
        await message.answer("Fragment не настроен")
        return
    try:
        from pyfragment import FragmentClient
        async with FragmentClient(
            seed=TON_SEED,
            api_key=TONAPI_KEY,
            cookies={
                "stel_ssid": FRAGMENT_SSID,
                "stel_dt": FRAGMENT_DT,
                "stel_token": FRAGMENT_TOKEN,
                "stel_ton_token": FRAGMENT_TON_TOKEN,
            },
            wallet_version="V4R2",
        ) as client:
            wallet = await client.get_wallet()
            await message.answer(
                f"Адрес: {wallet.address}\n"
                f"TON: {wallet.gram_balance}\n"
                f"USDT: {wallet.usdt_balance}"
            )
    except Exception as e:
        await message.answer(f"Ошибка: {e}")

