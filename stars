async def process_order_confirmation(order_id_prefix: str, admin_id: int, reply_func):
    """reply_func(text) - функция, чтобы ответить туда, откуда пришёл запрос (message.answer или callback.message.answer)."""
    found = find_order(order_id_prefix)
    if not found:
        await reply_func("Заказ не найден.")
        return

    if found["status"] not in PENDING_STATUSES:
        who = found.get("confirmed_by")
        who_text = f" администратором {who}" if who else ""
        await reply_func(f"⚠️ Этот заказ уже обработан{who_text}.\nТекущий статус: «{found['status']}»")
        return

    found["status"] = "оплачено"
    found["confirmed_by"] = admin_id
    save_data(data)

    if found.get("type") == "premium":
        months = found.get("months", 3)
        await reply_func(f"Заказ {order_id_prefix} подтверждён вами. Отправляю Premium через Fragment...")
        ok, details = await fragment_send_premium(found["recipient"], months)
        if ok:
            found["status"] = "выполнено"
            save_data(data)
            await reply_func(f"✅ Premium отправлен автоматически! {details}")
            await bot.send_message(
                int(found["user_id"]),
                f"✅ Заказ №{found['id'][:8]} подтверждён! 💎 Premium ({found['label']}) отправлен на {found['recipient']}.",
            )
            await send_review_request(int(found["user_id"]))
        else:
            found["status"] = "оплачено (нужна ручная отправка)"
            save_data(data)
            await reply_func(f"⚠️ Не удалось отправить автоматически: {details}\nОтправь Premium вручную получателю {found['recipient']}.")
            await bot.send_message(
                int(found["user_id"]),
                f"✅ Заказ №{found['id'][:8]} подтверждён! 💎 Premium ({found['label']}) скоро будет активирован.",
            )
            await send_review_request(int(found["user_id"]))
    else:
        buyer_id = int(found["user_id"])
        buyer = get_user(data, buyer_id)
        buyer["total_bought"] += found["amount"]
        save_data(data)

        await reply_func(f"Заказ {order_id_prefix} подтверждён вами. Отправляю {found['amount']}⭐ через Fragment...")
        ok, details = await fragment_send_stars(found["recipient"], found["amount"])
        if ok:
            found["status"] = "выполнено"
            save_data(data)
            await reply_func(f"✅ Звёзды отправлены автоматически! {details}")
            await bot.send_message(
                buyer_id,
                f"✅ Заказ №{found['id'][:8]} подтверждён! ⭐ {found['amount']} отправлено на {found['recipient']}.",
            )
            await send_review_request(buyer_id)
        else:
            found["status"] = "оплачено (нужна ручная отправка)"
            save_data(data)
            await reply_func(f"⚠️ Не удалось отправить автоматически: {details}\nОтправь {found['amount']}⭐ вручную получателю {found['recipient']}.")
            await bot.send_message(
                buyer_id,
                f"✅ Заказ №{found['id'][:8]} подтверждён! ⭐ {found['amount']} скоро будет отправлено.",
            )
            await send_review_request(buyer_id)

