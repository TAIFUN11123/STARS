def load_data():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    return {"users": {}, "orders": {}, "withdrawals": {}}

def save_data(d):
    # Атомарная запись: сначала во временный файл, потом переименование.
    # Это защищает data.json от повреждения, если процесс упадёт/перезапустится
    # прямо во время записи.
    tmp_file = DATA_FILE + ".tmp"
    with open(tmp_file, "w", encoding="utf-8") as f:
        json.dump(d, f, ensure_ascii=False, indent=2)
    os.replace(tmp_file, DATA_FILE)

def get_user(d, user_id):
    uid = str(user_id)
    if uid not in d["users"]:
        d["users"][uid] = {
            "username": "",
            "total_bought": 0,
            "referrals": [],
            "referral_earned": 0,
            "referral_withdrawn": 0,
        }
    u = d["users"][uid]
    u.setdefault("username", "")
    u.setdefault("total_bought", 0)
    u.setdefault("referrals", [])
    u.setdefault("referral_earned", 0)
    u.setdefault("referral_withdrawn", 0)
    return u

data = load_data()
data.setdefault("withdrawals", {})

def is_valid_username(text: str) -> bool:
    name = text.strip().lstrip("@")
    return MIN_USERNAME_LEN <= len(name) <= MAX_USERNAME_LEN

def is_admin(user_id: int) -> bool:
    return user_id in ADMIN_IDS

def find_order(order_prefix: str):
    return next((o for oid, o in data["orders"].items() if oid.startswith(order_prefix)), None)

def find_user_id_by_username(username: str):
    """Ищет user_id по username среди тех, кто хотя бы раз запускал бота."""
    username = username.strip().lstrip("@").lower()
    for uid, u in data["users"].items():
        if (u.get("username") or "").lower() == username:
            return uid
    return None

