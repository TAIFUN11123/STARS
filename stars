    current_balance = user["referral_earned"] - user["referral_withdrawn"]
    if current_balance < MIN_WITHDRAW:
        await message.answer(f"❌ Недостаточно звёзд для вывода. Ваш баланс: {current_balance:.2f} ⭐")
        await state.clear()
        return

    raw = message.text.strip()
    if not is_valid_username(raw):
        await message.answer(
            f"⚠️ Это должен быть именно юзернейм Telegram (от {MIN_USERNAME_LEN} до {MAX_USERNAME_LEN} символов), "
            "без номеров карт и прочих реквизитов.\nОтправьте @username ещё раз:"
        )
        return
    requisites = raw if raw.startswith("@") else "@" + raw

    withdraw_id = str(uuid.uuid4())
    data["withdrawals"][withdraw_id] = {
        "id": withdraw_id,
        "user_id": str(message.from_user.id),
        "username": message.from_user.username or "",
        "amount": current_balance,
        "requisites": requisites,
        "status": "ожидает выплаты",
        "created_at": datetime.now().isoformat(),
    }
    save_data(data)

    kb = admin_withdraw_kb(withdraw_id)
    for admin_id in ADMIN_IDS:
        try:
            await bot.send_message(
                admin_id,
                f"💸 Запрос на вывод №{withdraw_id[:8]}\n"
                f"От: @{message.from_user.username or message.from_user.id}\n"
                f"Сумма: {current_balance:.2f} звёзд\n"
                f"Юзернейм для перевода: {requisites}",
                reply_markup=kb,
            )
        except Exception:
            pass

    await state.clear()
    await send_screen(
        message,
        "✅ Заявка на вывод отправлена и будет обработана в ближайшее время.",
        reply_markup=main_menu_kb(),
    )

