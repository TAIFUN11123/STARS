CRYPTO_RUB_RATE = RATE / CRYPTO_STAR_RATE

def stars_to_usdt(amount: int) -> float:
    return round(amount * CRYPTO_STAR_RATE, 2)

def rub_to_usdt(rub_amount: float) -> float:
    return round(rub_amount / CRYPTO_RUB_RATE, 2)

def fmt_money(value) -> str:
    """Красиво отображает сумму: без ',00' там, где число целое."""
    value = float(value)
    if value.is_integer():
        return str(int(value))
    return f"{value:.2f}".rstrip("0").rstrip(".")

