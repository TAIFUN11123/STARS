@router.message(BuyStates.waiting_receipt, F.photo | F.document)
async def process_receipt(message: Message, state: FSMContext):
    d = await state.get_data()
    order = data["orders"].get(d.get("order_id"))
    if not order:
        await message.answer("⚠️ Заказ не найден, начните заново через /buy")
        await state.clear()
        return

    caption = (
        f"🧾 Чек по заказу №{order['id'][:8]} (звёзды)\nОт: @{message.from_user.username or message.from_user.id}\n"
        f"⭐ {order['amount']} → {order['recipient']}\n💵 {order['price']}₽"
    )
    kb = admin_order_kb(order["id"])
    for admin_id in ADMIN_IDS:
        try:
            if message.photo:
                await bot.send_photo(admin_id, message.photo[-1].file_id, caption=caption, reply_markup=kb)
            else:
                await bot.send_document(admin_id, message.document.file_id, caption=caption, reply_markup=kb)
        except Exception:
            pass

    order["status"] = "чек отправлен, ожидает проверки"
    save_data(data)
    await state.clear()
    await send_screen(message, "✅ Чек получен и отправлен на проверку. Спасибо за покупку! 🎉", reply_markup=main_menu_kb())

