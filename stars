@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    user = get_user(data, message.from_user.id)
    # Сохраняем/обновляем username, чтобы админ мог находить пользователя по нему
    user["username"] = message.from_user.username or ""
    save_data(data)

    args = message.text.split()
    if len(args) > 1 and args[1].startswith("ref_"):
        ref_id = args[1].replace("ref_", "")
        if ref_id != str(message.from_user.id):
            ref_user = get_user(data, ref_id)
            if message.from_user.id not in ref_user["referrals"]:
                ref_user["referrals"].append(message.from_user.id)
                ref_user["referral_earned"] += REFERRAL_BONUS
                save_data(data)
                try:
                    await bot.send_message(
                        int(ref_id),
                        f"🎉 По вашей ссылке зарегистрировался новый пользователь! Начислено {REFERRAL_BONUS} ⭐"
                    )
                except Exception:
                    pass

    await message.answer("👇", reply_markup=persistent_menu_kb())
    await show_main_menu(message)

