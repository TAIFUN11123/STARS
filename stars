def btn(text, callback_data=None, url=None, style=None, icon=None, fallback=""):
    """Кнопка с премиум-эмодзи (icon) и цветом (style: primary/success/danger)."""
    params = {}
    if callback_data:
        params["callback_data"] = callback_data
    if url:
        params["url"] = url
    if style and BUTTON_COLORS:
        params["style"] = style
    if icon and CUSTOM_EMOJI:
        params["icon_custom_emoji_id"] = icon
        label = text
    else:
        label = f"{fallback} {text}" if fallback else text
    return InlineKeyboardButton(text=label, **params)

