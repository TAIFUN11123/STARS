@router.message(BuyStates.entering_recipient)
async def process_recipient(message: Message, state: FSMContext):
    raw = message.text.strip()
    if not is_valid_username(raw):
        await message.answer(
            f"⚠️ Некорректный юзернейм. Он должен быть от {MIN_USERNAME_LEN} до {MAX_USERNAME_LEN} символов.\n"
            "Отправьте @username ещё раз:"
        )
        return
    recipient = raw if raw.startswith("@") else "@" + raw
    await state.update_data(recipient=recipient)
    await state.set_state(BuyStates.choosing_payment)
    d = await state.get_data()
    text = f"🎉 {d['amount']} ⭐ для {recipient} — {d['price']}₽\n\n💳 Способ оплаты:"
    await send_screen(message, text, reply_markup=payment_kb())

