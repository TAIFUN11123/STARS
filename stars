@router.message(BroadcastStates.entering_content)
async def process_broadcast(message: Message, state: FSMContext):
    if not is_admin(message.from_user.id):
        return

    user_ids = list(data["users"].keys())
    total = len(user_ids)
    sent, failed = 0, 0

    status = await message.answer(f"⏳ Рассылка запущена: 0/{total}")

    for i, uid in enumerate(user_ids, start=1):
        try:
            await message.copy_to(int(uid))
            sent += 1
        except Exception:
            failed += 1

        if i % 25 == 0 or i == total:
            try:
                await status.edit_text(f"⏳ Рассылка идёт: {i}/{total}")
            except Exception:
                pass

    await state.clear()
    try:
        await status.edit_text(
            f"✅ Рассылка завершена.\n\n"
            f"Всего получателей: {total}\n"
            f"Отправлено: {sent}\n"
            f"Не доставлено: {failed}"
        )
    except Exception:
        await message.answer(
            f"✅ Рассылка завершена.\n\n"
            f"Всего получателей: {total}\n"
            f"Отправлено: {sent}\n"
            f"Не доставлено: {failed}"
        )

