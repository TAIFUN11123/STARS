async def process_withdraw(message: Message, state: FSMContext):
    user = get_user(data, message.from_user.id)
    current_balance = user["referral_earned"] - user["referral_withdrawn"]
    d = await state.get_data()
    amount = d.get("withdraw_amount")
    if amount is None or amount > current_balance:
        await message.answer("⚠️ Сессия устарела или баланс изменился, начните вывод заново.")
        await state.clear()
        return

