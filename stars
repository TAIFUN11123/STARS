    found = next((w for wid, w in withdrawals.items() if wid.startswith(withdraw_prefix)), None)

    if not found:
        await callback.message.answer("Заявка на вывод не найдена.")
        await callback.answer()
        return
    if found["status"] != "ожидает выплаты":
        who = found.get("confirmed_by")
        who_text = f" администратором {who}" if who else ""
        await callback.message.answer(f"⚠️ Этот вывод уже обработан{who_text}.\nТекущий статус: «{found['status']}»")
        await callback.answer()
        return

    found["status"] = "отклонено"
    found["confirmed_by"] = callback.from_user.id
    save_data(data)
    await callback.message.answer(f"❌ Вывод {withdraw_prefix} отклонён вами.")
    try:
        await bot.send_message(int(found["user_id"]), f"❌ Ваш запрос на вывод №{found['id'][:8]} отклонён администратором.")
    except Exception:
        pass
    try:
        await callback.message.edit_reply_markup(reply_markup=None)
    except Exception:
        pass
    await callback.answer()

