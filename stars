async def edit_screen(callback: CallbackQuery, text: str, reply_markup=None, use_html: bool = False):
    kwargs = {"parse_mode": "HTML"} if use_html else {}
    try:
        media = InputMediaPhoto(media=BANNER_URL, caption=text, **kwargs)
        await callback.message.edit_media(media=media, reply_markup=reply_markup)
    except Exception:
        await callback.message.delete()
        await callback.message.answer_photo(photo=BANNER_URL, caption=text, reply_markup=reply_markup, **kwargs)

# -------------------- FRAGMENT: АВТОМАТИЧЕСКАЯ ОТПРАВКА --------------------

async def fragment_send_stars(recipient: str, amount: int):
    if not FRAGMENT_ENABLED:
        return False, "Fragment не настроен (нет переменных окружения)"
    try:
        from pyfragment import FragmentClient
        from pyfragment.enums import PaymentMethod

        async with FragmentClient(
            seed=TON_SEED,
            api_key=TONAPI_KEY,
            cookies={
                "stel_ssid": FRAGMENT_SSID,
                "stel_dt": FRAGMENT_DT,
                "stel_token": FRAGMENT_TOKEN,
                "stel_ton_token": FRAGMENT_TON_TOKEN,
            },
            wallet_version="V4R2",
        ) as client:
            result = await client.purchase_stars(recipient, amount=amount, payment_method=PaymentMethod.GRAM)
            return True, f"tx: {getattr(result, 'transaction_id', 'ok')}"
    except Exception as e:
        return False, str(e)

