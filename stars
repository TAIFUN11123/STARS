@router.message(WithdrawStates.entering_amount)
async def process_withdraw_amount(message: Message, state: FSMContext):
    user = get_user(data, message.from_user.id)
    current_balance = user["referral_earned"] - user["referral_withdrawn"]
    if current_balance < MIN_WITHDRAW:
        await message.answer(f"❌ Недостаточно звёзд для вывода. Ваш баланс: {current_balance:.2f} ⭐")
        await state.clear()
        return

    text = message.text.strip().replace(",", ".")
    if not text.replace(".", "", 1).isdigit():
        await message.answer("⚠️ Введите корректное число, например 50 или 120:")
        return

    amount = float(text)
    if amount < MIN_WITHDRAW:
        await message.answer(f"⚠️ Минимальная сумма для вывода — {MIN_WITHDRAW} ⭐. Введите количество ещё раз:")
        return
    if amount > current_balance:
        await message.answer(f"⚠️ У вас недостаточно звёзд. Ваш баланс: {current_balance:.2f} ⭐. Введите количество ещё раз:")
        return

    await state.update_data(withdraw_amount=amount)
    await state.set_state(WithdrawStates.entering_requisites)
    await message.answer(f"Отправьте юзернейм Telegram (от {MIN_USERNAME_LEN} до {MAX_USERNAME_LEN} символов):")

