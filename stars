@router.message(CommandStart())
async def cmd_start(message: Message, state: FSMContext):
    await state.clear()
    user = get_user(data, message.from_user.id)
    # Сохраняем/обновляем username, чтобы админ мог находить пользователя по нему
    user["username"] = message.from_user.username or ""
    save_data(data)

    args = message.text.split()

    # ---- Реферальная ссылка ----
    if len(args) > 1 and args[1].startswith("ref_"):
        ref_id = args[1].replace("ref_", "")
        if ref_id != str(message.from_user.id):
            ref_user = get_user(data, ref_id)
            if message.from_user.id not in ref_user["referrals"]:
                ref_user["referrals"].append(message.from_user.id)
                ref_user["referral_earned"] += REFERRAL_BONUS
                save_data(data)
                try:
                    await bot.send_message(
                        int(ref_id),
                        f"🎉 По вашей ссылке зарегистрировался новый пользователь! Начислено {REFERRAL_BONUS} ⭐"
                    )
                except Exception:
                    pass

    # ---- Чек (ссылка на получение звёзд) ----
    elif len(args) > 1 and args[1].startswith("check_"):
        code = args[1][len("check_"):]
        check = find_check(code)
        if not check:
            await message.answer("⚠️ Чек не найден или устарел.")
        elif message.from_user.id in check["claimed_by"]:
            await message.answer("Вы уже получили звёзды по этому чеку.")
        elif len(check["claimed_by"]) >= check["activations"]:
            await message.answer("⚠️ Все активации этого чека уже использованы.")
        else:
            check["claimed_by"].append(message.from_user.id)
            user["referral_earned"] += check["per_claim"]
            save_data(data)
            await message.answer(
                f"{ce(EMOJI_CHECK, '🎉')} Вы получили {fmt_money(check['per_claim'])} ⭐ по чеку!\n\n"
                f"Посмотреть баланс можно в разделе «Профиль».",
                parse_mode="HTML",
            )

    await message.answer("👇", reply_markup=persistent_menu_kb())
    await show_main_menu(message)

